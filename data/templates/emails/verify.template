<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>Verify your Veilance account</title>

  <!-- Subject: Verify your Veilance account -->
  <!-- Preheader: Use code !!CODE!! to complete verification. -->

  <style>
    @media screen and (max-width: 620px) {
      .email-shell {
        width: 100% !important;
      }

      .mobile-pad {
        padding-left: 24px !important;
        padding-right: 24px !important;
      }

      .hero-title {
        font-size: 34px !important;
        line-height: 1.12 !important;
      }

      .verification-code {
        font-size: 30px !important;
        letter-spacing: 5px !important;
      }
    }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#070c0f;color:#e9f1f1;font-family:Arial,Helvetica,sans-serif;">

  <div style="display:none!important;max-height:0;max-width:0;overflow:hidden;opacity:0;color:transparent;font-size:1px;line-height:1px;">
    Use code !!CODE!! to complete verification. This code is case sensitive and expires on !!TIME!!.
  </div>

  <table
    role="presentation"
    cellpadding="0"
    cellspacing="0"
    border="0"
    width="100%"
    bgcolor="#070c0f"
    style="border-collapse:collapse;background-color:#070c0f;"
  >
    <tr>
      <td align="center" style="padding:28px 12px 44px;">

        <!--[if mso]>
        <table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td>
        <![endif]-->

        <table
          role="presentation"
          class="email-shell"
          cellpadding="0"
          cellspacing="0"
          border="0"
          width="600"
          bgcolor="#0b1317"
          style="width:600px;max-width:100%;border-collapse:collapse;background-color:#0b1317;border:1px solid #243b42;"
        >

          <!-- HEADER -->
          <tr>
            <td
              class="mobile-pad"
              bgcolor="#050b0e"
              style="background-color:#050b0e;padding:22px 36px;border-bottom:1px solid #1e353c;"
            >
              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="border-collapse:collapse;"
              >
                <tr>
                  <td
                    align="left"
                    valign="middle"
                    style="color:#edf6f5;font-family:Arial,Helvetica,sans-serif;font-size:17px;font-weight:700;letter-spacing:2px;line-height:24px;"
                  >
                    <span style="color:#4bc5d1;">//</span>&nbsp;VEILANCE
                  </td>

                  <td
                    align="right"
                    valign="middle"
                    style="color:#829ba0;font-family:Consolas,Menlo,monospace;font-size:10px;letter-spacing:1px;line-height:18px;"
                  >
                    ACCOUNT SECURITY
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- INTRO -->
          <tr>
            <td class="mobile-pad" style="padding:48px 44px 28px;">

              <p
                style="margin:0 0 16px;color:#4bc5d1;font-family:Consolas,Menlo,monospace;font-size:11px;font-weight:700;letter-spacing:2px;line-height:18px;"
              >
                // VERIFY YOUR ACCOUNT
              </p>

              <h1
                class="hero-title"
                style="margin:0 0 20px;color:#e9f1f1;font-family:Arial,Helvetica,sans-serif;font-size:42px;font-weight:700;letter-spacing:-1.4px;line-height:1.08;"
              >
                Enter this verification code.
              </h1>

              <p
                style="margin:0;color:#b9cacd;font-size:16px;line-height:1.7;"
              >
                We received a request that requires verification. Enter the code below to continue.
              </p>

            </td>
          </tr>

          <!-- CODE -->
          <tr>
            <td class="mobile-pad" style="padding:0 44px 20px;">

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                bgcolor="#101d22"
                style="border-collapse:collapse;background-color:#101d22;border:1px solid #3b5961;border-left:3px solid #4bc5d1;"
              >
                <tr>
                  <td
                    align="center"
                    style="padding:22px 24px 8px;color:#829ba0;font-family:Consolas,Menlo,monospace;font-size:10px;font-weight:700;letter-spacing:1.8px;line-height:18px;"
                  >
                    VERIFICATION CODE
                  </td>
                </tr>

                <tr>
                  <td
                    class="verification-code"
                    align="center"
                    style="padding:5px 20px 12px;color:#e9f1f1;font-family:Consolas,Menlo,monospace;font-size:36px;font-weight:700;letter-spacing:6px;line-height:1.3;"
                  >
                    !!CODE!!
                  </td>
                </tr>

                <tr>
                  <td
                    align="center"
                    style="padding:4px 24px 8px;color:#b9cacd;font-size:12px;font-weight:700;line-height:1.6;"
                  >
                    This code is case sensitive.
                  </td>
                </tr>

                <tr>
                  <td
                    align="center"
                    style="padding:0 24px 23px;color:#829ba0;font-size:12px;line-height:1.6;"
                  >
                    This code expires in <strong style="color:#b9cacd;">!!TIME!!</strong>.
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- LOGIN BUTTON -->
          <tr>
            <td class="mobile-pad" align="center" style="padding:0 44px 30px;">

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                <tr>
                  <td
                    align="center"
                    bgcolor="#08798a"
                    style="background-color:#08798a;border:1px solid #4bc5d1;"
                  >
                    <a
                      href="!!BASE_URL!!/login"
                      style="display:inline-block;padding:14px 26px;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;line-height:20px;text-decoration:none;"
                    >
                      Go to Veilance Login
                    </a>
                  </td>
                </tr>
              </table>

              <p
                style="margin:14px 0 0;color:#829ba0;font-size:11px;line-height:1.6;"
              >
                Or visit
                <a
                  href="!!BASE_URL!!/login"
                  style="color:#75d7df;text-decoration:underline;"
                >
                  !!BASE_URL!!/login
                </a>
              </p>

            </td>
          </tr>

          <!-- SECURITY NOTICE -->
          <tr>
            <td
              class="mobile-pad"
              style="padding:25px 44px 30px;border-top:1px solid #243b42;background-color:#0b1317;"
            >

              <p
                style="margin:0 0 10px;color:#4bc5d1;font-family:Consolas,Menlo,monospace;font-size:11px;font-weight:700;letter-spacing:1.7px;line-height:18px;"
              >
                // SECURITY NOTICE
              </p>

              <p
                style="margin:0;color:#b9cacd;font-size:14px;line-height:1.65;"
              >
                Never share this code with anyone. Veilance will never ask you to send a verification code by email, support ticket, direct message, or social media.
              </p>

            </td>
          </tr>

          <!-- IGNORE -->
          <tr>
            <td class="mobile-pad" style="padding:0 44px 38px;">

              <p
                style="margin:0;color:#829ba0;font-size:13px;line-height:1.65;"
              >
                If you did not request this verification code, you can safely ignore this email.
              </p>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td
              class="mobile-pad"
              bgcolor="#050b0e"
              style="padding:22px 44px 25px;border-top:1px solid #1e353c;background-color:#050b0e;"
            >

              <p
                style="margin:0 0 12px;color:#829ba0;font-family:Consolas,Menlo,monospace;font-size:11px;line-height:1.6;"
              >
                BEYOND THE FINE PRINT.
              </p>

              <p
                style="margin:0 0 7px;color:#829ba0;font-size:11px;line-height:1.7;"
              >
                You received this email because a verification request was made for your Veilance account.
              </p>

              <p
                style="margin:0;color:#829ba0;font-size:11px;line-height:1.7;"
              >
                Veilance, a Revix Technologies company
                &nbsp;&middot;&nbsp;
                <a
                  href="https://veilance.org/privacy"
                  style="color:#75d7df;text-decoration:underline;"
                >
                  Privacy policy
                </a>
              </p>

            </td>
          </tr>

        </table>

        <!--[if mso]>
            </td>
          </tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>

</body>
</html>
